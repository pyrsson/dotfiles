{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" },
      { "action": "provider.use", "resource": "anthropic", "effect": "allow" }
    ]
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "basic-memory": {
        "type": "remote",
        "url": "{file:~/.config/opencode/secrets/basic-memory-url}",
        "oauth": false,
        "headers": {
          "x-api-key": "{file:~/.config/opencode/secrets/basic-memory-key}"
        },
        "disabled": false
      }
    }
  }
}
