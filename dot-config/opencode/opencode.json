{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "agents": {
    "explore": {
      "model": "anthropic/claude-haiku-5-5"
    },
    "reviewer": {
      "description": "Reviews code changes for correctness, regressions, and design issues. Use for thorough code review.",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5#high",
      "system": "Review the requested changes without modifying files. Report findings in severity order with file and line references.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" },
      { "action": "provider.use", "resource": "anthropic", "effect": "allow" }
    ]
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "basic-memory": {
        "command": ["uvx", "basic-memory@0.23.2", "mcp"],
        "disabled": false,
        "type": "local"
      }
    }
  }
}
