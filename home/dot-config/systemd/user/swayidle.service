[Unit]
Description=Sway Idle Service
After=graphical-session.target

[Service]
Type=simple
ExecStart=swayidle -w \
          lock 'lock-screen' \
          timeout 300 'loginctl lock-session' \
          timeout 600 'monitors-power off' \
          resume 'monitors-power on' \
          timeout 900 'systemctl suspend' \
          before-sleep 'lock-screen --wait'
Restart=on-failure

[Install]
WantedBy=graphical-session.target
