[bar]
{% if "thinkpad-x1" in mise_env | default(value=[]) %}
position = "left"
{% else %}
position = "top"
{% endif %}

# Spacing between widgets within each section (in pixels)
spacing = 6

# Distance from the screen edge to the bar window (in pixels)
screen_margin = 0

# Distance from the bar edge to the first/last section (in pixels)
inset = 4

# Border radius for the bar (percentage of bar height, 50% = fully rounded)
border_radius = 0

popover_offset = 6

background_opacity = 0.5
padding = 4
outline = false


[widgets]
border_radius = 50
background_opacity = 0.6
popover_background_opacity = 0.6
outline = false

left = [
  "notifications",
  "workspaces",
  "window_title",
]
center = []
right = [
  "custom-ddcutil",
  "custom-theme",
  "media",
  "tray",
  { group = ["cpu", "gpu", "memory"] },
  "battery",
  "quick_settings",
  "clock",
]

[weather]
location = "Ljungskile"

[widgets.clock]
show_weather = true
calendar_events = "dankcalendar"

[widgets.taskbar]
show_title = false
show_icon = true
show_active = true
icon_size = 20
filter_by_output = true
workspace_separator_label = "number"

[widgets.workspaces]
# label_type = "index"

[widgets.custom-ddcutil]
label = "Switch input"
icon = "output"
show_if = "{ niri msg -j outputs || hyprctl -j monitors; } 2>/dev/null | grep UK02338064882"
on_click = "ddcutil -n UK02338064882 setvcp 60 1"
tooltip = "Switch input source"
max_chars = 20

[widgets.custom-theme]
on_click = "swap-theme"
exec = "swap-theme check"
tooltip = "Switch theme"
icon = "light_mode"

[widgets.custom-theme.icons]
dark = "light_mode"
light = "dark_mode"

[theme]
mode = "auto"
scheme = "{{ vars.theme }}"
blur = true
outline = true
outline_width = 2

[theme.typography]
font_family = "Hack Nerd Font Mono"

[osd]
position = "left"

[audio]
allow_overdrive = true

[polkit]
enabled = true
