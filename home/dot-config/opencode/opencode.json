{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "agents": {
    "explore": {
      "model": "anthropic/claude-haiku-5-5"
    },
    "reviewer": {
      "description": "Reviews code changes for correctness, regressions, and design issues. Use for thorough code review.",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5#high",
      "system": "Review the requested changes without modifying files. Report findings in severity order with file and line references.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" },
      { "action": "provider.use", "resource": "anthropic", "effect": "allow" }
    ]
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "basic-memory": {
        "command": ["uvx", "basic-memory@0.23.2", "mcp"],
        "disabled": false,
        "type": "local"
      }
    }
  },
  "permissions": [
    { "action": "basic-memory_basic_memory_diagnostics", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_delete_note", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_read_content", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_view_note", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_list_directory", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_move_note", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_list_workspaces", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_list_memory_projects", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_create_memory_project", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_delete_project", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_search", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_fetch", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_schema_validate", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_schema_infer", "resource": "*", "effect": "deny" },
    { "action": "basic-memory_schema_diff", "resource": "*", "effect": "deny" }
  ]
}
